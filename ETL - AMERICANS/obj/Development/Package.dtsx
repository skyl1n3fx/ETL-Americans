                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT SUCURSAL.SUCURSAL_ID, SUCURSAL.NOMBRE_SUCURSAL, REGION.REGION, PROVINCIA.PROVINCIA, COMUNA.CIUDAD_COMUNA
FROM     COMUNA INNER JOIN
                  PROVINCIA ON COMUNA.PROVINCIA_ID = PROVINCIA.PROVINCIA_ID INNER JOIN
                  REGION ON PROVINCIA.REGION_ID = REGION.REGION_ID INNER JOIN
                  SUCURSAL ON COMUNA.COMUNA_ID = SUCURSAL.COMUNA_ID</property>
